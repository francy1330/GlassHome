<?xml version="1.0" encoding="utf-8"?>
<!-- GlassHome: launcher ispirato a tvOS per Fire TV. Basato su FireFrame (MIT), vedi LICENSE. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.glasshome.launcher" android:versionCode="2" android:versionName="1.1.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <!-- Android 11+ mostra a un launcher solo le app che dichiara di cercare. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Meteo (Open-Meteo, solo HTTPS) e, in futuro, il servizio delle tessere AI sul PC. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Icona Wi-Fi nella barra in alto (stato e intensità del segnale, non il nome della rete). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Opzioni > Memoria > Chiudi le app in background. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Nessun WAKE_LOCK: GlassHome non tiene mai acceso lo schermo né sveglia la CPU.
         Fase 2 (servizio sul PC in http): android:usesCleartextTraffic o una network security config. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="GlassHome" android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:allowBackup="false" android:hardwareAccelerated="true" android:largeHeap="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true" android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale">
            <!-- Una vera home su Android TV / Google TV. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Compare nell'elenco app di Fire TV. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".MainActivity$Boot" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Copre la home Amazon con GlassHome quando si apre (non la disattiva). Attivato da
             scripts/install, disattivato da scripts/restore-defaults. -->
        <service android:name=".HomeService"
            android:exported="true"
            android:label="GlassHome - tasto Home"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_service" />
        </service>
    </application>
</manifest>
